rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // Mandating email verification for better security
      return request.auth.token.email_verified == true;
    }

    function currentUserEmail() {
      return (request.auth != null && request.auth.token.email != null) ? request.auth.token.email.lower() : "";
    }

    function isAdmin() {
      return isSignedIn() && 
        (currentUserEmail() == 'hackeurfaurest@gmail.com' || 
         currentUserEmail() == 'dangafelicite@gmail.com' ||
         currentUserEmail() == 'yaoubaboubakary43@gmail.com');
    }

    function isValidId(id) {
      // More permissive ID validation to allow emails and common characters
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Relational sync helper
    function getCompanyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn() && companyId != null && (
        isAdmin() ||
        (get(/databases/$(database)/documents/companies/$(companyId)).data.ownerEmail == currentUserEmail() || 
         get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/personnel/$(currentUserEmail())) && 
         get(/databases/$(database)/documents/personnel/$(currentUserEmail())).data.companyId == companyId)
      );
    }

    // --- Collection Rules ---

    // 1. Companies / Compagnie
    match /{path=**}/companies/{companyId} {
      allow read, write: if false; // Overridden by specific match below
    }
    match /compagnie/{companyId} {
       allow read: if true;
       allow write: if isAdmin();
    }
    match /companies/{companyId} {
      function isValidCompany(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               (data.ownerEmail.lower() == currentUserEmail() || data.ownerId == request.auth.uid) &&
               data.joinCode is string && data.joinCode.size() >= 4 &&
               data.keys().hasAll(['name', 'ownerEmail', 'joinCode']) && data.keys().size() <= 15;
      }

      allow read: if true; // Public for marketplace discovery

      allow create: if isSignedIn() && isValidCompany(incoming()) && isValidId(companyId);

      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.ownerEmail.lower() == currentUserEmail() && isValidCompany(incoming())) ||
        // Action: Join (Allow a non-member to add themselves if they know the joinCode)
        (
          incoming().joinCode == existing().joinCode &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees', 'status', 'updatedAt']) &&
          incoming().memberEmails.hasAll(existing().memberEmails) &&
          incoming().memberEmails.size() == existing().memberEmails.size() + 1 &&
          currentUserEmail() in incoming().memberEmails
        ) ||
        // Action: Client Auto-Enroll (Allow users listed in 'clients' to sync their access)
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees', 'status', 'updatedAt']) &&
          incoming().memberEmails.size() == existing().memberEmails.size() + 1 &&
          currentUserEmail() in incoming().memberEmails &&
          exists(/databases/$(database)/documents/clients/$(currentUserEmail())) &&
          get(/databases/$(database)/documents/clients/$(currentUserEmail())).data.companyId == companyId
        ) ||
        // Action: Join via Code (Self-Enrollment)
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees', 'updatedAt']) &&
          incoming().memberEmails.size() == existing().memberEmails.size() + 1 &&
          currentUserEmail() in incoming().memberEmails &&
          incoming().joinCode == existing().joinCode // Verifies the secret code matches
        ) ||
        // Action: Personnel Auto-Enroll (Allow users listed in 'personnel' to sync their access)
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees', 'updatedAt']) &&
          incoming().memberEmails.size() == existing().memberEmails.size() + 1 &&
          currentUserEmail() in incoming().memberEmails &&
          exists(/databases/$(database)/documents/personnel/$(currentUserEmail())) &&
          get(/databases/$(database)/documents/personnel/$(currentUserEmail())).data.companyId == companyId
        ) ||
        // Action: Standard update for existing members
        (currentUserEmail() in resource.data.memberEmails && incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees', 'whatsappNumber', 'category', 'logo', 'nairaRate', 'updatedAt']))
      );

      allow delete: if isAdmin();
    }

    match /guide_steps/{stepId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
 
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || userId == request.auth.uid || userId == currentUserEmail());
      allow write: if isSignedIn() && (isAdmin() || userId == request.auth.uid || userId == currentUserEmail());
    }

    // 1.1.1 Masters (Whitelist)
    match /masters/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 1.2 Dedicated Ecommerce Orders & Company Entities
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /personnel/{personnelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }


    // Notification access
    match /notifications/{docId} {
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.email == currentUserEmail());
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.email == currentUserEmail());
      allow create: if true; // Allow anyone to notify the system (e.g. guest orders)
      allow update: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])));
      allow delete: if isAdmin();
    }

    match /global_orders/{orderId} {
      allow read: if true;
      allow create: if true;
      // Allow updates for sub-order splitting and status updates from marketplace
      allow update: if isAdmin() || (
        (incoming().diff(existing()).affectedKeys().hasOnly(['subOrderIds', 'paymentStatus', 'status', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    match /{collectionName}/{docId} {
      function isCompanyCollection() {
        return collectionName in [
          'personnel', 'clients', 'sales', 'projects', 'partners', 
          'expenses', 'resources', 'tasks', 'services', 
          'interventions', 'notifications', 'open_orders',
          'sales_invoices', 'invoices', 'payments', 'collaborations',
          'messages', 'project_discussions', 'leave_requests', 'time_entries', 'salary_advances',
          'ecommerce_orders', 'resource_movements', 'products', 'order_messages', 'compagnie', 'notification_configs', 'order_history',
          'internal_resources', 'stock_history'
        ];
      }

      function isValidInternalResource(data) {
        return isValidEntity(data) &&
               data.name is string && data.name.size() <= 200 &&
               data.type in ["Véhicule", "Électronique", "Mobilier", "Autre"] &&
               data.status in ["Opérationnel", "En panne", "En réparation"];
      }

      function isValidStockHistory(data) {
        return isValidEntity(data) &&
               data.productId is string && isValidId(data.productId) &&
               data.type in ["ENTREE", "SORTIE", "AJUSTEMENT"] &&
               data.quantity is number;
      }

      function isValidSale(data) {
        return isValidEntity(data) &&
               data.itemName is string && data.itemName.size() <= 200 &&
               data.total is number && data.total >= 0 &&
               data.keys().hasAll(['companyId', 'itemName', 'total']) && data.keys().size() <= 15;
      }

      function isValidEntity(data) {
        return (collectionName == 'global_orders') || (
          data.companyId is string && isValidId(data.companyId) && 
          (isAdmin() || collectionName in ['ecommerce_orders', 'order_history'] || isMemberOfCompany(data.companyId))
        );
      }

      function isSelf(data) {
        return (data.email != null && data.email == currentUserEmail()) ||
               (data.customerEmail != null && data.customerEmail == currentUserEmail()) ||
               (data.senderId != null && data.senderId == request.auth.uid) ||
               (data.senderEmail != null && data.senderEmail == currentUserEmail()) ||
               (data.recipientId != null && data.recipientId == request.auth.uid) ||
               (data.uid != null && data.uid == request.auth.uid) ||
               (data.userId != null && data.userId == request.auth.uid) ||
               (data.userIds != null && request.auth.uid in data.userIds);
      }

      // Read access: Admin, Company Member, or the User themselves (self-access)
      // Products, Services and guest Orders are public for the Marketplace
      allow get: if isCompanyCollection() && (
        collectionName in ['products', 'services', 'ecommerce_orders', 'order_history', 'global_orders'] ||
        (isSignedIn() && (
          isAdmin() || 
          docId == currentUserEmail() ||
          docId == request.auth.uid ||
          (resource != null && isSelf(resource.data)) ||
          (resource != null && resource.data.companyId != null && isMemberOfCompany(resource.data.companyId))
        ))
      );
      
      allow list: if isCompanyCollection() && (
        collectionName in ['products', 'services', 'ecommerce_orders', 'order_history', 'global_orders'] ||
        (isSignedIn() && (
          isAdmin() || 
          (resource != null && isSelf(resource.data)) ||
          (resource != null && resource.data.companyId != null && isMemberOfCompany(resource.data.companyId))
        ))
      );

      allow create: if isCompanyCollection() && 
                    isValidEntity(incoming()) && 
                    (isAdmin() || (
                      collectionName in ['ecommerce_orders', 'order_history', 'global_orders'] || 
                      (isSignedIn() && (
                        isMemberOfCompany(incoming().companyId) ||
                        isSelf(incoming())
                      ))
                    )) &&
                    (
                      (collectionName == 'internal_resources' && isValidInternalResource(incoming())) ||
                      (collectionName == 'stock_history' && isValidStockHistory(incoming())) ||
                      (collectionName == 'sales' && isValidSale(incoming())) ||
                      (collectionName != 'internal_resources' && collectionName != 'stock_history' && collectionName != 'sales')
                    ) &&
                    (incoming().createdAt == request.time || collectionName == 'messages' || collectionName == 'project_discussions' || collectionName == 'order_messages' || collectionName == 'stock_history' || collectionName == 'internal_resources');

      allow update: if isCompanyCollection() && (
                      isAdmin() || 
                      (isSignedIn() && (
                        isMemberOfCompany(existing().companyId) ||
                        isSelf(existing())
                      )) ||
                      // Allow guest order updates (cancellation or simulation)
                      (collectionName == 'ecommerce_orders' && (
                        existing().customerEmail == 'Marketplace Guest' ||
                        incoming().status == 'CANCELLED_BY_CUSTOMER'
                      )) ||
                      // Allow anyone to update stock (for order placement/cancellation increment)
                      // In a real app this should be more restricted or server-side
                      (collectionName == 'products' && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'views', 'soldCount', 'updatedAt']))
                    ) &&
                    incoming().companyId == existing().companyId &&
                    (
                      (collectionName == 'internal_resources' && isValidInternalResource(incoming())) ||
                      (collectionName != 'internal_resources')
                    ) &&
                    (incoming().updatedAt == request.time || collectionName == 'messages' || collectionName == 'project_discussions' || collectionName == 'order_messages' || collectionName == 'internal_resources');

      allow delete: if isSignedIn() && isCompanyCollection() && 
                      (isAdmin() || (
                        isMemberOfCompany(existing().companyId) ||
                        (isSelf(existing()) && collectionName == 'order_messages') // Allow deleting own messages
                      ));
    }
  }
}
