rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // Mandating email verification for better security
      return request.auth.token.email_verified == true;
    }

    function currentUserEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : "";
    }

    function isAdmin() {
      return isSignedIn() && 
        (currentUserEmail() == 'hackeurfaurest@gmail.com' || 
         currentUserEmail() == 'dangafelicite@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Relational sync helper
    function getCompanyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn() && companyId != null && exists(/databases/$(database)/documents/companies/$(companyId)) && (
        isAdmin() ||
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerEmail.lower() == currentUserEmail() || 
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid ||
        (get(/databases/$(database)/documents/companies/$(companyId)).data.memberEmails != null && currentUserEmail() in get(/databases/$(database)/documents/companies/$(companyId)).data.memberEmails)
      );
    }

    // --- Collection Rules ---

    // 1. Companies
    // Users can create companies. They can read/write if they are owner/member.
    match /companies/{companyId} {
      function isValidCompany(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               (data.ownerEmail.lower() == currentUserEmail() || data.ownerId == request.auth.uid) &&
               data.joinCode is string && data.joinCode.size() >= 4;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.ownerEmail.lower() == currentUserEmail() || 
        resource.data.ownerId == request.auth.uid ||
        (resource.data.memberEmails != null && currentUserEmail() in resource.data.memberEmails) ||
        // Permit finding by joinCode
        resource.data.joinCode != null
      );

      allow create: if isSignedIn() && isValidCompany(incoming()) && isValidId(companyId);

      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.ownerEmail.lower() == currentUserEmail() && isValidCompany(incoming())) ||
        // Action: Join (Allow a non-member to add themselves if they know the joinCode)
        (
          incoming().joinCode == existing().joinCode &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees']) &&
          incoming().memberEmails.hasAll(existing().memberEmails) &&
          incoming().memberEmails.size() == existing().memberEmails.size() + 1 &&
          currentUserEmail() in incoming().memberEmails
        ) ||
        // Action: Standard update for existing members
        (currentUserEmail() in resource.data.memberEmails && incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees']))
      );

      allow delete: if isAdmin();
    }

    // 1.1 Users
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
      allow write: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
    }

    // 1.1.1 Masters (Whitelist)
    match /masters/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 1.2 Dedicated Ecommerce Orders & Company Entities
    match /clients/{clientId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        (resource.data != null && resource.data.email.lower() == currentUserEmail()) ||
        (resource.data != null && resource.data.companyId != null && isMemberOfCompany(resource.data.companyId))
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data != null && resource.data.email.lower() == currentUserEmail()) ||
        (resource.data != null && isMemberOfCompany(resource.data.companyId))
      );
      allow delete: if isAdmin();
    }

    match /{collectionName}/{docId} {
      function isCompanyCollection() {
        return collectionName in [
          'personnel', 'clients', 'sales', 'projects', 'partners', 
          'expenses', 'resources', 'tasks', 'services', 
          'interventions', 'notifications', 'open_orders',
          'sales_invoices', 'invoices', 'payments', 'collaborations',
          'messages', 'project_discussions', 'leave_requests', 'time_entries', 'salary_advances',
          'ecommerce_orders', 'resource_movements', 'products', 'order_messages'
        ];
      }

      function isValidEntity(data) {
        return data.companyId is string && isValidId(data.companyId);
      }

      function isSelf(data) {
        return (data.email != null && data.email.lower() == currentUserEmail()) ||
               (data.customerEmail != null && data.customerEmail.lower() == currentUserEmail()) ||
               (data.senderId != null && data.senderId == request.auth.uid) ||
               (data.recipientId != null && data.recipientId == request.auth.uid) ||
               (data.uid != null && data.uid == request.auth.uid) ||
               (data.userIds != null && request.auth.uid in data.userIds);
      }

      // Read access: Admin, Company Member, or the User themselves (self-access)
      allow get: if isSignedIn() && isCompanyCollection() && (
        isAdmin() || 
        isSelf(resource.data) ||
        (resource.data.companyId != null && (
          isMemberOfCompany(resource.data.companyId) || 
          collectionName == 'products'
        ))
      );
      
      allow list: if isSignedIn() && isCompanyCollection() && (
        isAdmin() || 
        isSelf(resource.data) ||
        (resource.data.companyId != null && (
          isMemberOfCompany(resource.data.companyId) || 
          collectionName == 'products'
        ))
      );

      allow create: if isSignedIn() && isCompanyCollection() && 
                      isValidEntity(incoming()) && 
                      (isAdmin() || (
                        isMemberOfCompany(incoming().companyId) ||
                        isSelf(incoming()) ||
                        (collectionName == 'ecommerce_orders') // Allow clients to place orders
                      )) &&
                      (incoming().createdAt == request.time || collectionName == 'messages' || collectionName == 'project_discussions' || collectionName == 'order_messages');

      allow update: if isSignedIn() && isCompanyCollection() && 
                      (isAdmin() || (
                        isMemberOfCompany(existing().companyId) ||
                        isSelf(existing())
                      )) &&
                      incoming().companyId == existing().companyId &&
                      (incoming().updatedAt == request.time || collectionName == 'messages' || collectionName == 'project_discussions' || collectionName == 'order_messages');

      allow delete: if isSignedIn() && isCompanyCollection() && 
                      (isAdmin() || (
                        isMemberOfCompany(existing().companyId) ||
                        (isSelf(existing()) && collectionName == 'order_messages') // Allow deleting own messages
                      ));
    }
  }
}
