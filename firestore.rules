rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // Mandating email verification for better security
      return request.auth.token.email_verified == true;
    }

    function currentUserEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return isSignedIn() && (currentUserEmail() == 'hackeurfaurest@gmail.com' || currentUserEmail() == 'dangafelicite@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Relational sync helper
    function getCompanyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn() && companyId != null && (
        getCompanyData(companyId).ownerEmail == currentUserEmail() || 
        (getCompanyData(companyId).memberEmails != null && getCompanyData(companyId).memberEmails.contains(currentUserEmail()))
      );
    }

    // --- Collection Rules ---

    // 1. Companies
    match /companies/{companyId} {
      function isValidCompany(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.ownerEmail is string &&
               data.joinCode is string && data.joinCode.size() >= 4;
      }

      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.ownerEmail == currentUserEmail() || 
        (resource.data.memberEmails != null && resource.data.memberEmails.contains(currentUserEmail()))
      );

      allow create: if isSignedIn() && isEmailVerified() && isValidCompany(incoming()) && incoming().ownerEmail == currentUserEmail() && isValidId(companyId);

      allow update: if isSignedIn() && isEmailVerified() && (
        isAdmin() || 
        (resource.data.ownerEmail == currentUserEmail() && isValidCompany(incoming())) ||
        (resource.data.memberEmails.contains(currentUserEmail()) && incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees']))
      );

      allow delete: if isAdmin();
    }

    // 2. Generic Company-Owned Collections
    match /{collectionName}/{docId} {
      function isCompanyCollection() {
        return collectionName in [
          'personnel', 'clients', 'sales', 'projects', 'partners', 
          'expenses', 'resources', 'tasks', 'services', 
          'interventions', 'notifications', 'open_orders',
          'invoices', 'payments', 'sales_invoices', 'users'
        ];
      }

      function isValidEntity(data) {
        return data.companyId is string && isValidId(data.companyId);
      }

      // Single document read: verify membership
      allow get: if isSignedIn() && isCompanyCollection() && (isAdmin() || isMemberOfCompany(resource.data.companyId));
      
      // List: Admins can list all. Members must use query filtered by companyId.
      allow list: if isSignedIn() && isCompanyCollection() && (
        isAdmin() || 
        isMemberOfCompany(resource.data.companyId)
      );

      allow create: if isSignedIn() && isEmailVerified() && isCompanyCollection() && 
                      isValidEntity(incoming()) && 
                      (isAdmin() || isMemberOfCompany(incoming().companyId)) &&
                      incoming().createdAt == request.time;

      allow update: if isSignedIn() && isEmailVerified() && isCompanyCollection() && 
                      (isAdmin() || isMemberOfCompany(existing().companyId)) &&
                      incoming().companyId == existing().companyId &&
                      incoming().updatedAt == request.time;

      allow delete: if isSignedIn() && isEmailVerified() && isCompanyCollection() && 
                      (isAdmin() || isMemberOfCompany(existing().companyId));
    }

    // 3. Special Collections / Test
    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
