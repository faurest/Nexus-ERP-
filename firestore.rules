rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && (request.auth.token.email == 'hackeurfaurest@gmail.com' || request.auth.token.email == 'dangafelicite@gmail.com'); 
    }

    function isCompanyOwner(companyId) {
      return isSignedIn() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    function isCompanyMember(companyId) {
      let company = get(/databases/$(database)/documents/companies/$(companyId));
      return isSignedIn() && request.auth.token.email != null && company != null && company.data.get('memberEmails', []).hasAny([request.auth.token.email]);
    }

    function hasCompanyAccess(companyId) {
      return isAdmin() || isCompanyOwner(companyId) || isCompanyMember(companyId);
    }
    
    function isResourceCompanyAllowed(data) {
      return 'companyId' in data && hasCompanyAccess(data.companyId);
    }

    match /companies/{companyId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.ownerId == request.auth.uid || (request.auth.token.email != null && resource.data.get('memberEmails', []).hasAny([request.auth.token.email]))));
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || (isSignedIn() && hasCompanyAccess(resource.data.companyId));
      allow create: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
      allow update: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
      allow delete: if isAdmin();
    }

    match /personnel/{pId} {
      allow read: if isAdmin() || (isSignedIn() && hasCompanyAccess(resource.data.companyId));
      allow write: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
    }
    
    match /tasks/{tId} {
      allow read: if isAdmin() || (isSignedIn() && hasCompanyAccess(resource.data.companyId));
      allow write: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
    }
    
    match /resources/{rId} {
      allow read: if isAdmin() || (isSignedIn() && hasCompanyAccess(resource.data.companyId));
      allow write: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
    }
    
    match /projects/{prId} {
      allow read: if isAdmin() || (isSignedIn() && hasCompanyAccess(resource.data.companyId));
      allow write: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
    }
    
    match /partners/{paId} {
      allow read: if isAdmin() || (isSignedIn() && hasCompanyAccess(resource.data.companyId));
      allow write: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
    }

    match /expenses/{eId} {
      allow read: if isAdmin() || (isSignedIn() && hasCompanyAccess(resource.data.companyId));
      allow write: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
    }
    
    match /invoices/{iId} {
      allow read: if isAdmin() || (isSignedIn() && hasCompanyAccess(resource.data.companyId));
      allow write: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
    }
    
    match /payments/{pId} {
      allow read: if isAdmin() || (isSignedIn() && hasCompanyAccess(resource.data.companyId));
      allow write: if isAdmin() || (isSignedIn() && isResourceCompanyAllowed(request.resource.data));
    }
  }
}
