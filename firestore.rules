rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // Mandating email verification for better security
      return request.auth.token.email_verified == true;
    }

    function currentUserEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return isSignedIn() && (currentUserEmail() == 'hackeurfaurest@gmail.com' || currentUserEmail() == 'dangafelicite@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Relational sync helper
    function getCompanyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isMemberOfCompany(companyId) {
      let path = /databases/$(database)/documents/companies/$(companyId);
      return exists(path) && (
        get(path).data.ownerEmail.lower() == currentUserEmail() || 
        get(path).data.ownerId == request.auth.uid ||
        (get(path).data.memberEmails != null && get(path).data.memberEmails.contains(currentUserEmail()))
      );
    }

    // --- Collection Rules ---

    // 1. Companies
    // Users can create companies. They can read/write if they are owner/member.
    match /companies/{companyId} {
      function isValidCompany(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               (data.ownerEmail.lower() == currentUserEmail() || data.ownerId == request.auth.uid) &&
               data.joinCode is string && data.joinCode.size() >= 4;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.ownerEmail.lower() == currentUserEmail() || 
        resource.data.ownerId == request.auth.uid ||
        (resource.data.memberEmails != null && resource.data.memberEmails.contains(currentUserEmail())) ||
        // Permit finding by joinCode
        resource.data.joinCode != null
      );

      allow create: if isSignedIn() && isValidCompany(incoming()) && isValidId(companyId);

      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.ownerEmail.lower() == currentUserEmail() && isValidCompany(incoming())) ||
        // Action: Join (Allow a non-member to add themselves if they know the joinCode)
        (
          incoming().joinCode == existing().joinCode &&
          incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees']) &&
          incoming().memberEmails.hasAll(existing().memberEmails) &&
          incoming().memberEmails.size() == existing().memberEmails.size() + 1 &&
          incoming().memberEmails.contains(currentUserEmail())
        ) ||
        // Action: Standard update for existing members
        (resource.data.memberEmails.contains(currentUserEmail()) && incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'employees']))
      );

      allow delete: if isAdmin();
    }

    // 1.1 Users
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
      allow write: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
    }

    // 2. Generic Company-Owned Collections
    // Pattern: {collectionName} -> document {docId} { companyId: "..." }
    
    match /{collectionName}/{docId} {
      function isCompanyCollection() {
        return collectionName in [
          'personnel', 'clients', 'sales', 'projects', 'partners', 
          'expenses', 'resources', 'tasks', 'services', 
          'interventions', 'notifications', 'open_orders',
          'sales_invoices', 'invoices', 'payments', 'collaborations'
        ];
      }

      function isValidEntity(data) {
        return data.companyId is string && isValidId(data.companyId);
        // Additional field validation could be added here for each entity specifically
      }

      // Read access: Must be a member of the company referenced in the document
      // Note: allow get uses getCompanyData(resource.data.companyId) which is fine.
      // allow list MUST be secured.
      allow get: if isSignedIn() && isCompanyCollection() && (
        isAdmin() || 
        (isMemberOfCompany(resource.data.companyId) && (
          collectionName != 'collaborations' || 
          resource.data.recipientEmail == 'all' || 
          resource.data.recipientEmail.lower() == currentUserEmail() || 
          resource.data.senderEmail.lower() == currentUserEmail()
        )) ||
        (resource.data.email != null && resource.data.email.lower() == currentUserEmail())
      );
      
      // List optimization: forced to filter by companyId OR their own email
      allow list: if isSignedIn() && isCompanyCollection() && (
        isAdmin() || 
        (isMemberOfCompany(resource.data.companyId) && (
          collectionName != 'collaborations' || 
          resource.data.recipientEmail == 'all' || 
          resource.data.recipientEmail.lower() == currentUserEmail() || 
          resource.data.senderEmail.lower() == currentUserEmail()
        )) ||
        (resource.data.email != null && resource.data.email.lower() == currentUserEmail())
      );

      allow create: if isSignedIn() && isCompanyCollection() && 
                      isValidEntity(incoming()) && 
                      (isAdmin() || (
                        isMemberOfCompany(incoming().companyId) &&
                        (collectionName != 'collaborations' || incoming().senderEmail.lower() == currentUserEmail())
                      )) &&
                      incoming().createdAt == request.time;

      allow update: if isSignedIn() && isCompanyCollection() && 
                      (isAdmin() || (
                        isMemberOfCompany(existing().companyId) &&
                        (collectionName != 'collaborations' || existing().senderEmail.lower() == currentUserEmail())
                      )) &&
                      incoming().companyId == existing().companyId &&
                      incoming().updatedAt == request.time;

      allow delete: if isSignedIn() && isCompanyCollection() && 
                      (isAdmin() || (
                        isMemberOfCompany(existing().companyId) &&
                        (collectionName != 'collaborations' || existing().senderEmail.lower() == currentUserEmail())
                      ));
    }
  }
}
