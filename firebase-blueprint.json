        "endDate": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Business partner or provider",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "contactEmail": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Financial expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "projectId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "number" },
