        "description": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "projectId", "amount"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Resource or stock item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "condition": { "type": "string" },
        "duration": { "type": "string" },
        "warranty": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Task": {
      "title": "Task",
      "description": "Task record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "title": { "type": "string" },
        "assignedTo": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "title"]
    },
    "Service": {
      "title": "Service",
      "description": "Service offered by the company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Intervention": {
      "title": "Intervention",
      "description": "Intervention or maintenance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "client": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "client", "message"]
    },
    "Notification": {
      "title": "Notification",
      "description": "App notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "number" },
        "date": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "title", "message"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sales invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "items": { "type": "string" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "date": { "type": "number" }
      },
      "required": ["companyId", "invoiceNumber"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "date": { "type": "number" },
        "reference": { "type": "string" }
      },
      "required": ["companyId", "amount", "invoiceId"]
    },
    "OpenOrder": {
      "title": "Open Order",
      "description": "Currently open order (e.g. for a restaurant)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientName": { "type": "string" },
        "tableNumber": { "type": "string" },
        "items": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
