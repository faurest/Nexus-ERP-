{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Information about a company in the ERP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "joinCode": { "type": "string" },
        "memberEmails": { "type": "string" },
        "employees": { "type": "string" },
        "roles": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "ownerEmail", "joinCode"]
    },
    "Person": {
      "title": "Person",
      "description": "Personnel member or employee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "status": { "type": "string" },
        "tasksAssignedCount": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name", "email"]
    },
    "Client": {
      "title": "Client",
      "description": "CRM client information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "interactions": { "type": "string" },
        "salesTotal": { "type": "number" },
        "loyaltyPoints": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sales transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "itemName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "total": { "type": "number" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "clientName": { "type": "string" },
        "date": { "type": "number" }
      },
      "required": ["companyId", "itemName"]
    },
    "Project": {
      "title": "Project",
      "description": "Project management record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "partnerId": { "type": "string" },
        "budget": { "type": "number" },
