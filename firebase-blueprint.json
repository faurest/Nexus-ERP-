{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Information about a company in the ERP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "joinCode": { "type": "string" },
        "memberEmails": { "type": "string" },
        "employees": { "type": "string" },
        "roles": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "ownerEmail", "joinCode"]
    },
    "Person": {
      "title": "Person",
      "description": "Personnel member or employee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "status": { "type": "string" },
        "tasksAssignedCount": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name", "email"]
    },
    "Client": {
      "title": "Client",
      "description": "CRM client information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "interactions": { "type": "string" },
        "salesTotal": { "type": "number" },
        "loyaltyPoints": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sales transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "itemName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "total": { "type": "number" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "clientName": { "type": "string" },
        "date": { "type": "number" }
      },
      "required": ["companyId", "itemName"]
    },
    "Project": {
      "title": "Project",
      "description": "Project management record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "partnerId": { "type": "string" },
        "budget": { "type": "number" },
        "status": { "type": "string" },
        "startDate": { "type": "number" },
        "endDate": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Business partner or provider",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "contactEmail": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Financial expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "projectId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "projectId", "amount"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Resource or stock item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "condition": { "type": "string" },
        "duration": { "type": "string" },
        "warranty": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Task": {
      "title": "Task",
      "description": "Task record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "title": { "type": "string" },
        "assignedTo": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "title"]
    },
    "Service": {
      "title": "Service",
      "description": "Service offered by the company",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "name"]
    },
    "Intervention": {
      "title": "Intervention",
      "description": "Intervention or maintenance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "client": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "client", "message"]
    },
    "Notification": {
      "title": "Notification",
      "description": "App notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "number" },
        "date": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["companyId", "title", "message"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sales invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "items": { "type": "string" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "date": { "type": "number" }
      },
      "required": ["companyId", "invoiceNumber"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "date": { "type": "number" },
        "reference": { "type": "string" }
      },
      "required": ["companyId", "amount", "invoiceId"]
    },
    "OpenOrder": {
      "title": "Open Order",
      "description": "Currently open order (e.g. for a restaurant)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientName": { "type": "string" },
        "tableNumber": { "type": "string" },
        "items": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["companyId"]
    },
    "Collaboration": {
      "title": "Collaboration",
      "description": "Record of data transfer or collaboration between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "senderEmail": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "referenceId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileData": { "type": "string" },
        "createdAt": { "type": "number" },
        "readBy": { "type": "string" }
      },
      "required": ["companyId", "senderEmail", "recipientEmail", "title", "content"]
    },
    "Message": {
      "title": "Message",
      "description": "Direct message between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "isRead": { "type": "boolean" }
      },
      "required": ["companyId", "senderId", "recipientId", "content"]
    },
    "ProjectDiscussion": {
      "title": "Project Discussion",
      "description": "Threaded message related to a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "projectId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["companyId", "projectId", "senderId", "content"]
    },
    "LeaveRequest": {
      "title": "Leave Request",
      "description": "Employee leave or absence request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "staffId": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "type": { "type": "string", "enum": ["leave", "absence", "medical"] },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["companyId", "staffId", "startDate", "endDate", "type", "status"]
    },
    "TimeEntry": {
      "title": "Time Entry",
      "description": "Employee timesheet entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "staffId": { "type": "string" },
        "projectId": { "type": "string" },
        "date": { "type": "string" },
        "hours": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["companyId", "staffId", "date", "hours"]
    },
    "SalaryAdvance": {
      "title": "Salary Advance",
      "description": "Request for salary advance or down payment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "staffId": { "type": "string" },
        "amount": { "type": "number" },
        "requestDate": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "deductionMonth": { "type": "string", "description": "Format YYYY-MM" }
      },
      "required": ["companyId", "staffId", "amount", "requestDate", "status"]
    }
  },
  "firestore": {
    "companies": { "schema": "Company", "description": "Global companies list" },
    "personnel": { "schema": "Person", "description": "Personnel records" },
    "clients": { "schema": "Client", "description": "Client records" },
    "sales": { "schema": "Sale", "description": "Sales records" },
    "projects": { "schema": "Project", "description": "Project records" },
    "partners": { "schema": "Partner", "description": "Partner records" },
    "expenses": { "schema": "Expense", "description": "Expense records" },
    "resources": { "schema": "Resource", "description": "Resource records" },
    "tasks": { "schema": "Task", "description": "Task records" },
    "services": { "schema": "Service", "description": "Service records" },
    "interventions": { "schema": "Intervention", "description": "Intervention records" },
    "notifications": { "schema": "Notification", "description": "Notification records" },
    "sales_invoices": { "schema": "Invoice", "description": "Sales invoice records" },
    "invoices": { "schema": "Invoice", "description": "General invoice records" },
    "payments": { "schema": "Payment", "description": "Payment records" },
    "open_orders": { "schema": "OpenOrder", "description": "Open order records" },
    "collaborations": { "schema": "Collaboration", "description": "Collaboration and data transfer records" },
    "messages": { "schema": "Message", "description": "Direct user messages" },
    "project_discussions": { "schema": "ProjectDiscussion", "description": "Project-based discussions" },
    "leave_requests": { "schema": "LeaveRequest", "description": "Employee leave requests" },
    "time_entries": { "schema": "TimeEntry", "description": "Employee time entries" },
    "salary_advances": { "schema": "SalaryAdvance", "description": "Salary advance and down payment requests" }
  }
}
